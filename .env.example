# ============================================================================
# Temporal Environment Variables - Dokploy Configuration Example
# ============================================================================
# IMPORTANT: 
#   1. DO NOT commit .env file with real passwords to Git!
#   2. Set these variables in Dokploy UI → Environment
#   3. Generate secure passwords locally before pasting to Dokploy
# ============================================================================

# === 时区设置 (Timezone) ===
TZ=Asia/Shanghai

# === 必需配置 (Required) - 数据库 ===
# Generate password locally:
#   echo "scripttask_$(openssl rand -hex 16)"
# Then paste the generated value to Dokploy UI
POSTGRES_USER=temporal
POSTGRES_PASSWORD=CHANGE_ME_IN_DOKPLOY_UI
POSTGRES_DB=temporal

# === 可选配置 (Optional) - 数据库性能优化 ===
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100

# === 必需配置 (Required) - 服务版本 ===
TEMPORAL_VERSION=1.29.1
TEMPORAL_UI_VERSION=2.34.0
TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
ELASTICSEARCH_VERSION=7.17.27
POSTGRESQL_VERSION=16

# ============================================================================
# 部署步骤 (Deployment Steps)
# ============================================================================
# 1. 在本地生成密码:
#    echo "scripttask_$(openssl rand -hex 16)"
#
# 2. 在 Dokploy UI → Environment 中设置:
#    TZ=Asia/Shanghai
#    POSTGRES_USER=temporal
#    POSTGRES_PASSWORD=<生成的密码>
#    POSTGRES_DB=temporal
#    TEMPORAL_VERSION=1.29.1
#    TEMPORAL_UI_VERSION=2.34.0
#    TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
#    ELASTICSEARCH_VERSION=7.17.27
#    POSTGRESQL_VERSION=16
#
# 3. 部署 Compose 服务
#
# 4. 验证服务状态:
#    docker ps
#    docker logs temporal
# ============================================================================
